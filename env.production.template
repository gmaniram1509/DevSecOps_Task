# Production Environment Variables Template
# Copy this to .env and fill in your values

# ============================================
# Django Core Settings
# ============================================
DJANGO_SECRET_KEY=your-secret-key-here-change-this-to-random-50-chars
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=task_manager.settings_production

# ============================================
# Allowed Hosts (comma-separated)
# ============================================
DJANGO_ALLOWED_HOSTS=.elasticbeanstalk.com,.amazonaws.com,yourdomain.com

# ============================================
# AWS RDS PostgreSQL Database
# ============================================
RDS_DB_NAME=taskmanager
RDS_USERNAME=dbadmin
RDS_PASSWORD=change-this-to-secure-password
RDS_HOSTNAME=your-db-instance.region.rds.amazonaws.com
RDS_PORT=5432

# ============================================
# AWS S3 Storage for Static/Media Files
# ============================================
AWS_STORAGE_BUCKET_NAME=your-bucket-name-here
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================
# AWS ElastiCache Redis (Optional)
# ============================================
ELASTICACHE_ENDPOINT=your-cache-endpoint.cache.amazonaws.com

# ============================================
# AWS SES Email Service (Optional)
# ============================================
AWS_SES_REGION=us-east-1
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Custom Domain Configuration (Optional)
# ============================================
CUSTOM_DOMAIN=yourdomain.com
AWS_DOMAIN=your-app.elasticbeanstalk.com
AWS_ALB_DNS=your-alb.region.elb.amazonaws.com

# ============================================
# Django Superuser (for automatic creation)
# ============================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=secure-admin-password-change-this

# ============================================
# Security Settings
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================
# Notes:
# - Never commit this file to version control
# - Use AWS Secrets Manager for production
# - Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# - Keep backups of this file securely
# ============================================

